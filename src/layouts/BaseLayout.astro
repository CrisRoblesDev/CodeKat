---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  themeColor?: string;
  canonical?: string;
  fontHref: string;
  css?: string[];
  bodyData?: Record<string, string>;
  mainClass?: string;
  footerId?: string;
  isHome?: boolean;
  footerAccent?: "purple" | "amber";
  withLoader?: boolean;
  withScrollProgress?: boolean;
  bgVariant?: "aurora" | "aurora4" | "fx";
  scripts?: string[];
}

const {
  title,
  description,
  lang = "es-CL",
  themeColor = "#8B5CF6",
  canonical,
  fontHref,
  css = [],
  bodyData,
  mainClass,
  footerId,
  isHome = false,
  footerAccent = "amber",
  withLoader = false,
  withScrollProgress = false,
  bgVariant = "aurora",
  scripts = [],
} = Astro.props;

const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const katColor = footerAccent === "purple" ? "color:var(--purple-light)" : "color:var(--amb-light)";

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://codekat.store/#organization",
  name: "CodeKat",
  url: "https://codekat.store/",
  logo: "https://codekat.store/favicon-512x512.png",
  image: "https://codekat.store/favicon-512x512.png",
  email: "crisdev.chile@gmail.com",
  telephone: "+56933465843",
  areaServed: { "@type": "Country", name: "Chile" },
  knowsLanguage: "es",
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style is:inline>
      /* ═══════════════════════════════════════════════
         CRITICAL CSS — Prevenir FOUC y parpadeo
         ═══════════════════════════════════════════════ */
      html{opacity:0;transition:opacity .2s ease;}
      html.theme-ready{opacity:1;}
      html.theme-switching{transition:none!important;}
      html.theme-switching *,html.theme-switching *::before,html.theme-switching *::after{transition:none!important;}
      body{opacity:0;transition:opacity .2s ease;}
      body.theme-ready{opacity:1;}
      #pageLoader{position:fixed;inset:0;z-index:9999;background:var(--bg,#08080D);display:grid;place-items:center;overflow:hidden;transition:opacity .6s var(--ease),visibility .6s var(--ease),filter .6s var(--ease);filter:blur(0) scale(1);}
      #pageLoader.hidden{opacity:0;visibility:hidden;pointer-events:none;filter:blur(18px) scale(1.04);transform:scale(1.04);}
      .pl-inner{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:1.4rem;}
      .pl-ring{position:relative;width:110px;height:110px;display:grid;place-items:center;}
      .pl-ring::before{content:'';position:absolute;inset:0;border-radius:50%;border:2px solid rgba(245,165,36,.15);}
      .pl-ring::after{content:'';position:absolute;inset:-4px;border-radius:50%;border:2px solid transparent;border-top-color:var(--amb-soft,#D4880A);border-right-color:var(--amb-light,#FFD080);animation:spin 1.8s cubic-bezier(.4,0,.2,1) infinite;box-shadow:0 0 18px var(--amb-glow,rgba(245,165,36,.3));}
      .pl-logo{width:72px;height:72px;border-radius:18px;object-fit:contain;background:var(--surface,#16161F);padding:8px;border:1px solid var(--glass-border,rgba(245,165,36,.2));animation:loaderPulse 1.4s ease-in-out infinite;}
      @keyframes loaderPulse{0%,100%{transform:scale(1);}50%{transform:scale(1.05);}}
      .pl-brand{font-family:var(--font-display,'Geist',sans-serif);font-weight:700;font-size:1.6rem;color:#fff;letter-spacing:-.02em;}
      .pl-brand span{color:var(--amb-light,#FFD080);}
      .pl-sub{font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:var(--text-muted,#9A96A8);}
      .pl-bar{width:160px;height:3px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden;}
      .pl-bar span{display:block;height:100%;width:0%;background:linear-gradient(90deg,var(--amb-soft,#D4880A),var(--amb-light,#FFD080));animation:plFill 3.2s ease-in-out forwards;box-shadow:0 0 10px var(--amb-glow,rgba(245,165,36,.3));}
      @keyframes plFill{to{width:100%;}}
      @keyframes spin{to{transform:rotate(360deg);}}
      /* ═══════════════════════════════════════════════
         FIN CRITICAL CSS
         ═══════════════════════════════════════════════ */
    </style>
    <script is:inline>
      (function(){
        try{var t=localStorage.getItem('codekat-theme')||'dark';
        if(t==='light'){document.documentElement.setAttribute('data-theme','light');}
        else{document.documentElement.removeAttribute('data-theme');}}catch(e){}
        requestAnimationFrame(function(){
          document.documentElement.classList.add('theme-ready');
          document.body.classList.add('theme-ready');
        });
        document.addEventListener('visibilitychange',function(){
          document.documentElement.classList.toggle('tabs-hidden',document.hidden);
        });
      })();
      window.addEventListener('load',function(){
        setTimeout(function(){var l=document.getElementById('pageLoader');if(l)l.classList.add('hidden');},300);
        setTimeout(function(){var l=document.getElementById('pageLoader');if(l&&!l.classList.contains('hidden'))l.classList.add('hidden');},4000);
      });
    </script>
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="author" content="CodeKat" />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content={themeColor} />

  <link rel="icon" href="/assets/images/logos/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/logos/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/logos/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/images/logos/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/logos/favicon-192x192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/images/logos/favicon-512x512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/logos/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontHref} rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  {css.map((href) => <link rel="stylesheet" href={href} />)}
  <slot name="head" />
</head>
<body {...bodyData}>
  {withLoader && (
    <div id="pageLoader" aria-hidden="false" aria-label="Cargando CodeKat">
      <div class="pl-inner">
        <div class="pl-ring"><img src="/assets/images/logos/Logo.png" alt="CodeKat" class="pl-logo" /></div>
        <div class="pl-brand">Code<span>Kat</span></div>
        <div class="pl-sub">Desarrollo Web · Chile</div>
        <div class="pl-bar"><span></span></div>
      </div>
    </div>
  )}
  {withScrollProgress && <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>}
  {bgVariant === "fx" ? (
    <div class="bg-fx" aria-hidden="true"></div>
  ) : (
    <div class="bg-aurora" aria-hidden="true">
      <span class="aurora a1"></span><span class="aurora a2"></span><span class="aurora a3"></span>
      {bgVariant === "aurora4" && <span class="aurora a4"></span>}
    </div>
  )}

  <header class="navbar" id="navbar" role="banner">
    <div class="container nav-inner">
      <a href={anchor("inicio")} class="brand" aria-label="CodeKat — Inicio">
        <img src="/assets/images/logos/Logo.png" alt="Logotipo de CodeKat" class="brand-logo" />
        <span class="brand-name">Code<span>Kat</span></span>
      </a>
      <div class="nav-right">
        <button class="theme-toggle-mini" id="themeToggleMini" aria-label="Cambiar tema"><i class="fa-solid fa-moon" id="themeIconMini"></i></button>
        <button class="burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="navMenu">
          <span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </div>
  </header>

  <nav class="nav-menu" id="navMenu" aria-label="Menú principal" aria-hidden="true">
    <div class="menu-header">
      <button class="menu-back" id="menuBack" aria-label="Volver y cerrar el menú"><i class="fa-solid fa-arrow-left"></i><span>Volver</span></button>
      <div class="menu-theme" role="group" aria-label="Cambiar tema">
        <button class="theme-btn" data-theme-set="dark" aria-label="Tema oscuro"><i class="fa-solid fa-moon"></i></button>
        <button class="theme-btn active" data-theme-set="light" aria-label="Tema claro"><i class="fa-solid fa-sun"></i></button>
      </div>
    </div>
    <ul class="menu-links">
      <li><a class="menu-link active" href={anchor("inicio")}><span class="link-left"><span class="link-icon"><i class="fa-solid fa-house"></i></span><span class="link-text"><span class="num">01 — Inicio</span><span class="link-title">Bienvenida</span><span class="link-desc">Tu próxima web comienza aquí</span></span></span><i class="fa-solid fa-arrow-right link-arrow"></i></a></li>
      <li><a class="menu-link" href={anchor("servicios")}><span class="link-left"><span class="link-icon"><i class="fa-solid fa-star"></i></span><span class="link-text"><span class="num">02 — Servicios</span><span class="link-title">Qué ofrecemos</span><span class="link-desc">Soluciones que hacen crecer tu negocio</span></span></span><i class="fa-solid fa-arrow-right link-arrow"></i></a></li>
      <li><a class="menu-link" href={anchor("cotizacion")}><span class="link-left"><span class="link-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span><span class="link-text"><span class="num">03 — Cotización</span><span class="link-title">Cotiza tu web</span><span class="link-desc">3 preguntas y listo</span></span></span><i class="fa-solid fa-arrow-right link-arrow"></i></a></li>
      <li><a class="menu-link" href={anchor("faq")}><span class="link-left"><span class="link-icon"><i class="fa-solid fa-circle-question"></i></span><span class="link-text"><span class="num">04 — FAQ</span><span class="link-title">Preguntas frecuentes</span><span class="link-desc">Respondemos las dudas comunes</span></span></span><i class="fa-solid fa-arrow-right link-arrow"></i></a></li>
      <li><a href="/cotizador/" class="menu-link"><span class="link-left"><span class="link-icon"><i class="fa-solid fa-calculator"></i></span><span class="link-text"><span class="num">05 — Cotizador APP</span><span class="link-title">Cotizador online</span><span class="link-desc">Crea una cotización para tu negocio</span></span></span><i class="fa-solid fa-arrow-right link-arrow"></i></a></li>
<li><a href="/remuneracion/" class="menu-link"><span class="link-left"><span class="link-icon"><i class="fa-solid fa-university"></i></span><span class="link-text"><span class="num">06 — Remuneración APP</span><span class="link-title">Remuneración online</span><span class="link-desc">Calcula tu remuneración</span></span></span><i class="fa-solid fa-arrow-right link-arrow"></i></a></li>
<li><a href="/qr/" class="menu-link"><span class="link-left"><span class="link-icon"><i class="fa-solid fa-qrcode"></i></span><span class="link-text"><span class="num">07 — QR Kat APP</span><span class="link-title">QR personalizados</span><span class="link-desc">Crea QR con tu estilo</span></span></span><i class="fa-solid fa-arrow-right link-arrow"></i></a></li>
     </ul>
    <div class="menu-footer">
      <a href="https://wa.me/56933465843" target="_blank" rel="noopener" class="menu-contact-card wa">
        <span class="mcc-icon"><i class="fa-brands fa-whatsapp"></i></span>
        <span class="mcc-body"><span class="mcc-title">WhatsApp</span><span class="mcc-sub">+56 9 3346 5843 · Respuesta rápida</span></span>
        <span class="mcc-arrow"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
      </a>
      <a href="mailto:crisdev.chile@gmail.com" class="menu-contact-card mail">
        <span class="mcc-icon"><i class="fa-regular fa-envelope"></i></span>
        <span class="mcc-body"><span class="mcc-title">Correo</span><span class="mcc-sub">crisdev.chile@gmail.com</span></span>
        <span class="mcc-arrow"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
      </a>
    </div>
  </nav>

  <button class="back-to-top" id="backToTop" aria-label="Volver arriba"><i class="fa-solid fa-arrow-up"></i></button>

  <a href="https://wa.me/56933465843" class="wa-float" id="waFloat" target="_blank" rel="noopener" aria-label="Asesórate con nosotros por WhatsApp">
    <span class="wa-tooltip" id="waTooltip">Asesórate con nosotros</span>
    <span class="wa-icon"><i class="fa-brands fa-whatsapp"></i></span>
  </a>

  <slot name="pre-main" />

  <main class={mainClass}>
    <slot />
  </main>

  <footer class="footer" id={footerId} role="contentinfo">
    <div class="footer-cta">
      {isHome && <div class="footer-aurora" aria-hidden="true"></div>}
      <div class="container reveal">
        <h2 class="footer-title">Tu próxima web <em class="grad-text">te está esperando</em>.</h2>
        <p class="footer-sub">Conversemos hoy y hagámosla realidad.</p>
        <div class="footer-actions">
          <a href="https://wa.me/56933465843" class="btn btn-primary grad-anim" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Hablar por WhatsApp</a>
          <a href={anchor("faq")} class="btn btn-glass">Ver FAQ <i class="fa-solid fa-arrow-right"></i></a>
        </div>
      </div>
    </div>
    <div class="footer-marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Landing Pages <i class="fa-solid fa-star"></i> Páginas informativas <i class="fa-solid fa-star"></i> Captación de clientes <i class="fa-solid fa-star"></i> SEO <i class="fa-solid fa-star"></i> Desarrollo a medida <i class="fa-solid fa-star"></i></span>
        <span>Landing Pages <i class="fa-solid fa-star"></i> Páginas informativas <i class="fa-solid fa-star"></i> Captación de clientes <i class="fa-solid fa-star"></i> SEO <i class="fa-solid fa-star"></i> Desarrollo a medida <i class="fa-solid fa-star"></i></span>
      </div>
    </div>
    {isHome && <div class="footer-giant" aria-hidden="true">CODEKAT</div>}
    <div class="container footer-bottom">
      <div class="footer-brand-mini"><img src="/assets/images/logos/Logo.png" alt="CodeKat" loading="lazy" /><span>Code<span style={katColor}>Kat</span></span></div>
      <nav class="footer-links" aria-label="Enlaces del pie"><a href={anchor("inicio")}>Inicio</a><a href={anchor("servicios")}>Servicios</a><a href={anchor("cotizacion")}>Cotización</a><a href={anchor("faq")}>FAQ</a><a href="/cotizador/">Cotizador</a><a href="/qr/">QR Kat</a></nav>
      <span class="footer-copy">© 2026 CodeKat — Desarrollo Web</span>
      {isHome && <span class="footer-made">Hecho con <i class="fa-solid fa-heart" aria-hidden="true"></i> en Chile</span>}
    </div>
  </footer>

  <slot name="after-footer" />

  {scripts.map((src) => <script is:inline src={src} defer></script>)}
</body>
</html>
