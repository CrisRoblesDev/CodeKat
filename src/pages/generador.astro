---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="LandingKat | CodeKat"
  lang="es"
  themeColor="#08080D"
  fontHref="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
  bodyData={{ "data-ws": "diseno" }}
  footerAccent="purple"
  bgVariant="fx"
  css={["/assets/css/pages/generador.css"]}
  scripts={[
    "/assets/js/functions/generador-app.js",
    "/assets/js/functions/reveal.js",
  ]}
>
  <Fragment slot="head">
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  </Fragment>

  <Fragment slot="pre-main">
    <section class="hero-strip">
      <h1 id="appTitle" data-text="Generador Pro">LandingKat</h1>
      <p>Crea landing pages profesionales: elige una aleación, personaliza cada pieza y descarga el código. Cada diseño tiene un <em>código único</em> que puedes copiar, guardar y volver a cargar.</p>
      <div class="hero-stats">
        <span><b>100</b> aleaciones</span><span><b>100</b> tipos de landing</span><span><b>100</b> fondos</span><span><b>5</b> formatos de exportación</span>
      </div>
    </section>
    <div class="ws-switch" id="wsSwitch">
      <button data-w="diseno" class="on">Diseño y secciones</button>
      <button data-w="vista">Vista y código</button>
    </div>
  </Fragment>

  <main class="workspace">
    <aside class="controls">
      <div class="tabs-bar" role="tablist">
        <button class="tab-btn on" data-tab="contenido">Contenido</button>
        <button class="tab-btn" data-tab="estilo">Estilo</button>
        <button class="tab-btn" data-tab="fondo">Fondo</button>
        <button class="tab-btn" data-tab="componentes">Componentes</button>
      </div>
      <div class="tabpanel on" data-panel="contenido">
        <section class="panel">
          <div class="panel-h"><span class="panel-num">01</span><h2>Secciones</h2></div>
          <p class="panel-sub">Toca ✎ para editar textos · ↑↓ para cambiar el orden.</p>
          <div class="sec-list" id="secList"></div>
          <div style="margin-top:12px"><button class="add-sec" id="btnAddSec">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Agregar sección…</button></div>
          <div style="margin-top:10px;text-align:right"><button class="link-btn" id="btnRestoreType">↺ Restaurar del tipo elegido</button></div>
        </section>
        <section class="panel">
          <div class="panel-h"><span class="panel-num">02</span><h2>Tu marca</h2></div>
          <p class="panel-sub">Logo, nombre y textos. Elige un rubro para usar sugerencias.</p>
          <div class="logo-zone">
            <div class="logo-prev" id="logoPrev">✦</div>
            <div style="display:flex;flex-direction:column;gap:7px;flex:1">
              <input type="file" id="logoFile" accept="image/*" hidden>
              <button class="btn-app ghost" id="btnLogoFile" style="padding:9px 13px;font-size:12px">Subir logo</button>
              <button class="link-btn" id="btnLogoDel">Quitar logo</button>
            </div>
          </div>
          <label class="fld"><span>O pegar URL del logo</span><input type="text" id="logoUrl" placeholder="https://…/logo.png"></label>
          <div class="fld-row" style="margin-bottom:12px">
            <label class="fld" style="margin:0"><span>Nombre de marca</span><input type="text" id="inBrand" value="Lumen"></label>
            <label class="fld" style="margin:0"><span>Rubro</span><select id="selRubro"></select></label>
          </div>
          <div class="packs" id="rubroPacks"></div>
          <label class="fld"><span>Eslogan (título principal)</span><input type="text" id="inSlogan" value="Ilumina la forma en que trabajas"></label>
          <label class="fld"><span>Descripción corta</span><textarea id="inDesc">Lumen es la plataforma que centraliza tus proyectos, automatiza lo repetible y le da a tu equipo claridad en tiempo real.</textarea></label>
          <div class="fld-row">
            <label class="fld" style="margin:0"><span>Botón principal</span><input type="text" id="inCta1" value="Empezar gratis"></label>
            <label class="fld" style="margin:0"><span>Botón secundario</span><input type="text" id="inCta2" value="Ver demo"></label>
          </div>
        </section>
      </div>
      <div class="tabpanel" data-panel="estilo">
        <section class="panel">
          <div class="panel-h"><span class="panel-num">01</span><h2>Aleación</h2></div>
          <p class="panel-sub">La personalidad visual: colores, tipografías y forma coordinados.</p>
          <div class="filter-row" id="alloyFilters"></div>
          <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="text" id="alloySearch" placeholder="Buscar aleación… (ej: neón, elegante, rosa)">
          </div>
          <div class="rail" id="alloyRail"></div>
        </section>
        <section class="panel">
          <div class="panel-h"><span class="panel-num">02</span><h2>Tipo de landing</h2></div>
          <p class="panel-sub">100 estructuras curadas. Filtra por familia.</p>
          <select class="sel-mini" id="typeFamily"></select>
          <div class="rail" id="typeRail"></div>
        </section>
        <section class="panel">
          <div class="panel-h"><span class="panel-num">03</span><h2>Colores</h2></div>
          <p class="panel-sub">Parte con una paleta sugerida y ajusta a gusto.</p>
          <div class="rail" id="palettesRail"></div>
          <div class="fld-row" style="margin-bottom:12px">
            <label class="color-field"><input type="color" id="colPrimary" value="#6E56F8"><span class="cf-t"><b>Principal</b><small id="hexP">#6E56F8</small></span></label>
            <label class="color-field"><input type="color" id="colAccent" value="#37D4C0"><span class="cf-t"><b>Acento</b><small id="hexA">#37D4C0</small></span></label>
          </div>
          <div style="display:flex;gap:16px">
            <button class="link-btn" id="btnSwapColors">⇄ Intercambiar</button>
            <button class="link-btn" id="btnResetColors">↺ Colores de la aleación</button>
          </div>
        </section>
        <section class="panel">
          <div class="panel-h"><span class="panel-num">04</span><h2>Tipografía</h2></div>
          <div class="fld-row" style="margin-bottom:12px">
            <label class="fld" style="margin:0"><span>Títulos</span><select id="selFontH"></select></label>
            <label class="fld" style="margin:0"><span>Texto</span><select id="selFontB"></select></label>
          </div>
          <label class="fld"><span>Tamaño de títulos</span>
            <div class="range-row"><input type="range" id="rngHead" min="1" max="3" step="1" value="2"><output id="outHead">Grande</output></div>
          </label>
          <div class="font-prev" id="fontPrev">
            <div class="fp-h">Convierte visitas en clientes</div>
            <div class="fp-b">Así se verá el cuerpo de texto.</div>
          </div>
        </section>
        <section class="panel">
          <div class="panel-h"><span class="panel-num">05</span><h2>Forma</h2></div>
          <label class="fld"><span>Radio de bordes</span>
            <div class="range-row"><input type="range" id="rngRadius" min="0" max="28" step="1" value="16"><output id="outRadius">16px</output></div>
          </label>
          <div class="fld"><span>Botones (forma)</span>
            <div class="seg" id="segBtn"><button data-v="recto">Rectos</button><button data-v="redondeado" class="on">Redondeados</button><button data-v="pildora">Píldora</button></div></div>
          <div class="fld" style="margin-bottom:0"><span>Sombras</span>
            <div class="seg" id="segShadow"><button data-v="ninguna">Sin</button><button data-v="sutil">Sutil</button><button data-v="media" class="on">Media</button><button data-v="alta">Alta</button></div></div>
        </section>
      </div>
      <div class="tabpanel" data-panel="fondo">
        <section class="panel">
          <div class="panel-h"><span class="panel-num">01</span><h2>Fondo de la página</h2></div>
          <p class="panel-sub">100 fondos con previsualización real.</p>
          <div class="bg-live" id="bgLive" title="Vista previa del fondo actual"></div>
          <div class="filter-row" id="bgFilters"></div>
          <div class="rail" id="bgRail"></div>
        </section>
        <section class="panel">
          <div class="panel-h"><span class="panel-num">02</span><h2>Efectos</h2></div>
          <div class="tgl-row"><span class="tt"><b>Brillo ambiental</b><small>Halos de color en el fondo</small></span><span class="tgl"><input type="checkbox" id="tglGlow" checked><i></i></span></div>
          <div class="tgl-row"><span class="tt"><b>Textura de grano</b><small>Acabado mate tipo impresión</small></span><span class="tgl"><input type="checkbox" id="tglGrain"><i></i></span></div>
          <div class="tgl-row"><span class="tt"><b>Barra translúcida</b><small>Navbar con desenfoque</small></span><span class="tgl"><input type="checkbox" id="tglGlass" checked><i></i></span></div>
        </section>
      </div>
      <div class="tabpanel" data-panel="componentes">
        <section class="panel">
          <div class="panel-h"><span class="panel-num">01</span><h2>Componentes de la landing</h2></div>
          <p class="panel-sub">Elige el estilo de cada pieza.</p>
          <div class="fld"><span>Navbar</span><div class="rail tight" id="railNav"></div></div>
          <div class="fld"><span>Tarjetas</span><div class="rail tight" id="railCard"></div></div>
          <div class="fld"><span>Botones</span><div class="rail tight" id="railBtn"></div></div>
          <div class="fld" style="margin-bottom:0"><span>Animaciones</span><div class="rail tight" id="railAnim"></div></div>
        </section>
        <section class="panel">
          <div class="panel-h"><span class="panel-num">02</span><h2>Posición y estructura</h2></div>
          <div class="fld"><span>Alineación del hero</span>
            <div class="seg" id="segAlign"><button data-v="auto" class="on">Según tipo</button><button data-v="izq">Izquierda</button><button data-v="centro">Centrado</button></div></div>
          <div class="fld"><span>Ancho del contenedor</span>
            <div class="seg" id="segContainer"><button data-v="estrecho">Estrecho</button><button data-v="normal" class="on">Normal</button><button data-v="ancho">Ancho</button></div></div>
          <div class="fld"><span>Tamaño de botones</span>
            <div class="seg" id="segBtnSize"><button data-v="compacto">Compacto</button><button data-v="normal" class="on">Normal</button><button data-v="grande">Grande</button></div></div>
          <div class="tgl-row"><span class="tt"><b>Bloques alternados</b><small>Invierte la posición de cada bloque destacado</small></span><span class="tgl"><input type="checkbox" id="tglAlt"><i></i></span></div>
          <div class="tgl-row"><span class="tt"><b>Navbar fija al hacer scroll</b><small>Si lo apagas, queda estática arriba</small></span><span class="tgl"><input type="checkbox" id="tglNavSticky" checked><i></i></span></div>
          <div class="fld" style="margin:12px 0 0"><span>Espaciado entre secciones</span>
            <div class="seg" id="segDensity"><button data-v="compacto">Compacto</button><button data-v="normal" class="on">Normal</button><button data-v="amplio">Amplio</button></div></div>
        </section>
      </div>
    </aside>
    <section class="stage">
      <div class="stage-stick">
        <section class="panel">
          <div class="panel-h"><span class="panel-num">▶</span><h2>Vista previa en vivo</h2></div>
          <div class="seg" id="segDevice" style="margin-bottom:12px">
            <button data-v="movil" class="on">Móvil</button><button data-v="tablet">Tablet</button><button data-v="escritorio">Escritorio</button>
          </div>
          <div class="pv-stage">
            <div class="pv-frame" id="pvFrame"><iframe id="pvIframe" title="Vista previa en vivo"></iframe></div>
            <div class="pv-cap"><span id="pvSize">390 px</span><span id="pvScale">escala 100%</span></div>
          </div>
          <p style="font-size:11.5px;color:var(--faint);text-align:center;margin-top:9px">Desliza dentro del marco para recorrer la página ↕</p>
          <div class="load-row">
            <input type="text" id="loadCode" placeholder="Pega aquí un código de diseño (CK-…)">
            <button class="btn-app ghost" id="btnLoadCode" style="flex:none;padding:10px 16px">Cargar</button>
          </div>
          <div class="btn-row" style="margin-top:10px">
            <button class="btn-app ghost" id="btnOpenTab">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 4h6v6M20 4 11 13M9 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-3"/></svg>Abrir en pestaña</button>
            <button class="btn-app ghost" id="btnReload">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.6-6.3M21 4v5h-5"/></svg>Recargar</button>
          </div>
        </section>
      </div>
      <section class="panel" style="margin-top:14px">
        <div class="panel-h"><span class="panel-num">{"{ }"}</span><h2>Tu código</h2></div>
        <div class="seg scrollable" id="segFormat" style="margin-bottom:12px">
          <button data-v="full" class="on">HTML+CSS+JS</button><button data-v="html">HTML</button><button data-v="css">CSS</button><button data-v="js">JS</button><button data-v="img">IMAGEN</button>
        </div>
        <div class="code-box" id="codeBoxWrap">
          <div class="code-top">
            <span class="dots"><i></i><i></i><i></i></span>
            <span class="fname" id="codeName">index.html</span>
            <span class="fmeta" id="codeMeta">— KB</span>
          </div>
          <pre><code id="codeOut"></code></pre>
        </div>
        <p class="code-note" id="codeNote"></p>
        <div class="btn-row" style="margin-top:12px">
          <button class="btn-app pri" id="btnCopy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copiar código</button>
          <button class="btn-app ghost" id="btnDownloadCode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>Descargar</button>
        </div>
        <div class="btn-row" style="margin-top:9px">
          <a class="btn-app wa" id="waRequestCode" href="https://wa.me/56933465843" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L3 21l1.9-5.6A8.5 8.5 0 1 1 21 11.5z"/></svg>¿Lo hacemos por ti? Solicitar esta landing</a>
        </div>
      </section>
    </section>
  </main>

  <Fragment slot="after-footer">
    <button class="eye-fab" id="eyeFab" aria-label="Vista previa rápida" title="Vista previa rápida">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
    <div class="eye-overlay" id="eyeOverlay" aria-hidden="true">
      <div class="eye-top">
        <div class="eye-seg" id="eyeDevice">
          <button data-v="movil" class="on">Móvil</button><button data-v="tablet">Tablet</button><button data-v="escritorio">Escritorio</button>
        </div>
        <button class="eye-close" id="eyeClose" aria-label="Cerrar vista previa">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="eye-frame-wrap" id="eyeFrameWrap">
        <div class="eye-frame" id="eyeFrame"><iframe id="eyeIframe" title="Vista previa rápida"></iframe></div>
      </div>
    </div>
    <div class="dcode" id="dcode">
      <span><span class="dc-t">Código del diseño</span><span class="dc-v" id="dcVal">CK-…</span></span>
      <button id="dcCopy">Copiar</button>
    </div>
    <button class="fab" id="fabRnd" aria-label="Generar diseño al azar" title="Diseño al azar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.4" fill="currentColor" stroke="none"/><circle cx="15.5" cy="8.5" r="1.4" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="8.5" cy="15.5" r="1.4" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15.5" r="1.4" fill="currentColor" stroke="none"/></svg>
    </button>
    <div class="sheet-bd" id="sheetBd"></div>
    <div class="sheet" id="sheet"><div class="sheet-grip"></div><div id="sheetBody"></div></div>
    <div class="toast" id="toast" role="status"></div>
  </Fragment>
</BaseLayout>
