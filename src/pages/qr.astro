---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="QR Kat | Generador de códigos QR personalizados"
  description="Crea códigos QR hiper-personalizados en segundos: colores, degradados, formas, logo y descarga en PNG o SVG. Fácil de usar desde tu celular."
  themeColor="#8B5CF6"
  canonical="https://codekat.store/qr/"
  fontHref="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
  footerAccent="purple"
  bgVariant="aurora4"
  css={[
    "/assets/css/colors.css",
    "/assets/css/design.css",
    "/assets/css/components.css",
    "/assets/css/system.css",
    "/assets/css/footer.css",
    "/assets/css/pages/qr.css",
  ]}
  scripts={[
    "https://unpkg.com/qr-code-styling@1.6.0/lib/qr-code-styling.js",
    "/assets/js/functions/theme.js",
    "/assets/js/functions/menu.js",
    "/assets/js/functions/qr-aether.js",
    "/assets/js/functions/qr-app.js",
  ]}
  bodyData={{ class: "qr-page" }}
>
  <Fragment slot="head">
    <meta name="keywords" content="generador QR, código QR personalizado, QR con logo, QR Chile, CodeKat" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://codekat.store/qr/" />
    <meta property="og:site_name" content="CodeKat" />
    <meta property="og:title" content="QR Kat | Generador de códigos QR personalizados" />
    <meta property="og:description" content="QR hiper-personalizados en segundos: colores, formas, logo y descarga PNG/SVG." />
    <meta property="og:locale" content="es_CL" />
  </Fragment>

  <Fragment slot="pre-main">
    <div class="container qr-intro">
      <h1>QR <em class="grad-text">Kat</em></h1>
      <p>Códigos QR con tu estilo, listos para escanear</p>
    </div>
  </Fragment>

  <div class="container">
    <div class="qr-shell">
      <!-- VISTA 0 · LANDING estilo Aether Flow -->
      <section class="qr-view qr-landing on" id="qrLanding" aria-label="Presentación">
        <canvas id="qrAether" aria-hidden="true"></canvas>
        <div class="qr-hero">
          <span class="qr-badge"><i class="fa-solid fa-bolt"></i> QR Kat · 100% gratis</span>
          <h2>QR que se sienten <em>vivos</em></h2>
          <p>Tus colores, tus formas, tu logo. Listo en segundos, desde tu celular.</p>
          <div class="qr-demo" aria-hidden="true">
            <div id="qrDemoMini"></div>
            <svg id="qrDemoFallback" viewBox="0 0 100 100"><rect width="100" height="100" rx="14" fill="#fff"></rect><g fill="#8B5CF6"><rect x="12" y="12" width="26" height="26" rx="7"></rect><rect x="62" y="12" width="26" height="26" rx="7"></rect><rect x="12" y="62" width="26" height="26" rx="7"></rect><rect x="18" y="18" width="14" height="14" rx="4" fill="#fff"></rect><rect x="68" y="18" width="14" height="14" rx="4" fill="#fff"></rect><rect x="18" y="68" width="14" height="14" rx="4" fill="#fff"></rect><circle cx="68" cy="68" r="4"></circle><circle cx="78" cy="68" r="4"></circle><circle cx="68" cy="78" r="4"></circle><rect x="46" y="14" width="8" height="8" rx="2"></rect><rect x="46" y="46" width="8" height="8" rx="4"></rect><rect x="14" y="46" width="8" height="8" rx="4"></rect><circle cx="82" cy="46" r="4" fill="#F5A524"></circle><rect x="46" y="78" width="8" height="8" rx="2" fill="#F5A524"></circle></g></svg>
          </div>
          <div class="qr-cta-row">
            <button class="btn btn-primary grad-anim qr-cta" id="qrStart" type="button"><i class="fa-solid fa-qrcode"></i> Crear mi QR gratis</button>
            <button class="btn btn-glass" id="qrSample" type="button">Ver ejemplo</button>
          </div>
          <div class="qr-stats" aria-label="Ventajas"><span><b>6</b> estilos</span><span><b>0</b> registro</span><span><b>3</b> formatos</span></div>
          <p class="qr-note">Sin cuenta · Sin marca de agua</p>
        </div>
      </section>

      <!-- VISTA 1 · GENERADOR -->
      <section class="qr-view" id="qrApp" data-view="app" aria-label="Generador QR" hidden>
        <div class="qr-topbar">
          <button class="qr-back" id="qrBack" type="button" aria-label="Volver al inicio">‹ Inicio</button>
          <b>Tu QR en vivo</b>
          <button class="qr-reset" id="qrReset" type="button" aria-label="Quitar logo">✕ logo</button>
        </div>

        <div class="qr-mid">
          <div class="qr-stage">
            <div class="qr-mini" id="qrMini" data-style="marca">
              <div class="qr-mini-title" id="qrMiniTitle">Mi QR</div>
              <div class="qr-mini-sub" id="qrMiniSub" hidden></div>
              <div id="qrPreview" role="img" aria-label="Vista previa del código QR"></div>
              <div class="qr-mini-nets" id="qrMiniNets" hidden></div>
            </div>
            <div class="qr-stage-meta">
              <small>Vista previa en vivo</small>
              <div id="qrStatus">Listo para escanear</div>
              <div class="qr-quick">
                <button id="qrPng" type="button"><i class="fa-solid fa-download"></i> PNG</button>
                <button id="qrCopy" type="button"><i class="fa-solid fa-copy"></i> Copiar</button>
              </div>
            </div>
          </div>

          <div class="qr-tabs" role="tablist" aria-label="Pasos">
            <button type="button" role="tab" data-step="0" class="on" aria-selected="true">1 · Contenido</button>
            <button type="button" role="tab" data-step="1" aria-selected="false">2 · Diseño</button>
            <button type="button" role="tab" data-step="2" aria-selected="false">3 · Descargar</button>
          </div>

          <div class="qr-panels">
            <div class="qr-panel on" data-panel="0" role="tabpanel" aria-label="Contenido">
              <div class="qr-seg" id="qrType" role="tablist" aria-label="Tipo de contenido">
                <button type="button" data-type="url" class="on">Link</button>
                <button type="button" data-type="text">Texto</button>
                <button type="button" data-type="wifi">WiFi</button>
              </div>
              <div class="qr-field" id="qrTextWrap">
                <label for="qrText">Contenido del QR</label>
                <textarea id="qrText">https://codekat.store</textarea>
                <span class="qr-count" id="qrCount">21 caracteres</span>
              </div>
              <div class="qr-wifi" id="qrWifiWrap" hidden>
                <div class="qr-field"><label for="qrSsid">Nombre de la red (SSID)</label><input type="text" id="qrSsid" placeholder="MiCasa_5G" /></div>
                <div class="qr-row2">
                  <div class="qr-field"><label for="qrWifiPass">Clave</label><input type="text" id="qrWifiPass" placeholder="••••••••" /></div>
                  <div class="qr-field"><label for="qrWifiEnc">Seguridad</label><select id="qrWifiEnc"><option value="WPA">WPA/WPA2</option><option value="WEP">WEP</option><option value="none">Abierta</option></select></div>
                </div>
              </div>
              <div class="qr-field"><label for="qrEcc">Nivel de corrección (más alto = aguanta logo)</label>
                <select id="qrEcc"><option value="L">L · Simple</option><option value="M" selected>M · Recomendado</option><option value="Q">Q · Con logo</option><option value="H">H · Máximo</option></select>
              </div>
              <div class="qr-cardfields">
                <div class="qr-field"><label for="qrCardTitle">Título (se ve en el preview y la tarjeta)</label><input type="text" id="qrCardTitle" placeholder="Ej: Café Aurora — Menú" /></div>
                <div class="qr-field"><label for="qrCardSub">Subtítulo</label><input type="text" id="qrCardSub" placeholder="Ej: Escanea y síguenos" /></div>
                <div class="qr-row2">
                  <div class="qr-field"><label for="qrNet1">Red 1</label><select id="qrNet1"><option value="ig">Instagram</option><option value="tt">TikTok</option><option value="wa">WhatsApp</option><option value="fb">Facebook</option><option value="x">X</option><option value="web">Web</option></select></div>
                  <div class="qr-field"><label for="qrHandle1">Usuario 1</label><input type="text" id="qrHandle1" placeholder="@tu_cuenta" /></div>
                </div>
                <div class="qr-row2">
                  <div class="qr-field"><label for="qrNet2">Red 2</label><select id="qrNet2"><option value="tt">TikTok</option><option value="ig">Instagram</option><option value="wa">WhatsApp</option><option value="fb">Facebook</option><option value="x">X</option><option value="web">Web</option></select></div>
                  <div class="qr-field"><label for="qrHandle2">Usuario 2</label><input type="text" id="qrHandle2" placeholder="@tu_cuenta" /></div>
                </div>
                <div class="qr-field"><label>Estilo de tarjeta</label>
                  <input type="hidden" id="qrCardStyle" value="marca" />
                  <div class="qr-seg qr-seg-4" id="qrCardSeg">
                    <button type="button" data-card="claro">Clara</button>
                    <button type="button" data-card="oscuro">Oscura</button>
                    <button type="button" data-card="marca" class="on">Marca</button>
                    <button type="button" data-card="custom">Mía</button>
                  </div>
                </div>
                <div class="qr-grid2" id="qrCardCustom" hidden>
                  <div class="qr-color"><input type="color" id="qrCardBg1" value="#8b5cf6" /><span>Fondo 1</span></div>
                  <div class="qr-color"><input type="color" id="qrCardBg2" value="#f5a524" /><span>Fondo 2</span></div>
                </div>
              </div>
            </div>

            <div class="qr-panel" data-panel="1" role="tabpanel" aria-label="Diseño">
              <div class="qr-field"><label>Temas rápidos (1 toque)</label>
                <div class="qr-presets" id="qrPresets">
                  <button type="button" data-p="codekat" class="on" aria-label="Tema CodeKat"><i style="background:linear-gradient(135deg,#8B5CF6,#F5A524)"></i>Kat</button>
                  <button type="button" data-p="ocean" aria-label="Tema océano"><i style="background:linear-gradient(135deg,#0EA5E9,#6366F1)"></i>Mar</button>
                  <button type="button" data-p="sunset" aria-label="Tema atardecer"><i style="background:linear-gradient(135deg,#F43F5E,#F59E0B)"></i>Sol</button>
                  <button type="button" data-p="selva" aria-label="Tema selva"><i style="background:linear-gradient(135deg,#16A34A,#84CC16)"></i>Selva</button>
                  <button type="button" data-p="mono" aria-label="Tema monocromo"><i style="background:linear-gradient(135deg,#111111,#6B7280)"></i>Mono</button>
                  <button type="button" data-p="vino" aria-label="Tema vino"><i style="background:linear-gradient(135deg,#7C2D12,#DB2777)"></i>Vino</button>
                </div>
              </div>
              <div class="qr-rows" role="list" aria-label="Opciones de personalización">
                <button type="button" class="qr-row" data-modal="opt-colors" data-title="Colores" role="listitem"><span class="qr-row-ico"><i class="fa-solid fa-palette"></i></span><span class="qr-row-tx"><b>Colores</b><small id="sumColors">—</small></span><i class="fa-solid fa-chevron-right"></i></button>
                <button type="button" class="qr-row" data-modal="opt-gradient" data-title="Degradado" role="listitem"><span class="qr-row-ico"><i class="fa-solid fa-fill-drip"></i></span><span class="qr-row-tx"><b>Degradado</b><small id="sumGrad">—</small></span><i class="fa-solid fa-chevron-right"></i></button>
                <button type="button" class="qr-row" data-modal="opt-dots" data-title="Estilo de puntos" role="listitem"><span class="qr-row-ico"><i class="fa-solid fa-shapes"></i></span><span class="qr-row-tx"><b>Puntos</b><small id="sumDots">—</small></span><i class="fa-solid fa-chevron-right"></i></button>
                <button type="button" class="qr-row" data-modal="opt-corners" data-title="Esquinas" role="listitem"><span class="qr-row-ico"><i class="fa-solid fa-vector-square"></i></span><span class="qr-row-tx"><b>Esquinas</b><small id="sumCorners">—</small></span><i class="fa-solid fa-chevron-right"></i></button>
                <button type="button" class="qr-row" data-modal="opt-logo" data-title="Logo al centro" role="listitem"><span class="qr-row-ico"><i class="fa-solid fa-image"></i></span><span class="qr-row-tx"><b>Logo</b><small id="sumLogo">—</small></span><i class="fa-solid fa-chevron-right"></i></button>
                <button type="button" class="qr-row" data-modal="opt-frame" data-title="Marco y margen" role="listitem"><span class="qr-row-ico"><i class="fa-solid fa-expand"></i></span><span class="qr-row-tx"><b>Marco</b><small id="sumFrame">—</small></span><i class="fa-solid fa-chevron-right"></i></button>
              </div>
            </div>

            <div id="qrOptStore" hidden aria-hidden="true">
              <div class="qr-opt" id="opt-colors">
                <div class="qr-grid2">
                  <div class="qr-color"><input type="color" id="qrDot" value="#8b5cf6" /><span>Puntos</span></div>
                  <div class="qr-color"><input type="color" id="qrBg" value="#ffffff" /><span>Fondo</span></div>
                </div>
                <div class="qr-sw" id="qrDotSw" aria-label="Colores de puntos">
                  <button type="button" data-c="#8b5cf6" style="--sw:#8b5cf6" aria-label="Violeta"></button>
                  <button type="button" data-c="#111827" style="--sw:#111827" aria-label="Negro"></button>
                  <button type="button" data-c="#1d4ed8" style="--sw:#1d4ed8" aria-label="Azul"></button>
                  <button type="button" data-c="#0284c7" style="--sw:#0284c7" aria-label="Celeste"></button>
                  <button type="button" data-c="#dc2626" style="--sw:#dc2626" aria-label="Rojo"></button>
                  <button type="button" data-c="#db2777" style="--sw:#db2777" aria-label="Fucsia"></button>
                  <button type="button" data-c="#15803d" style="--sw:#15803d" aria-label="Verde"></button>
                  <button type="button" data-c="#ea580c" style="--sw:#ea580c" aria-label="Naranja"></button>
                </div>
                <div class="qr-field"><label>Fondos que sí se escanean</label>
                  <div class="qr-sw qr-sw-bg" id="qrBgSw" aria-label="Colores de fondo">
                    <button type="button" data-c="#ffffff" style="--sw:#ffffff" aria-label="Blanco"></button>
                    <button type="button" data-c="#fff7ed" style="--sw:#fff7ed" aria-label="Crema"></button>
                    <button type="button" data-c="#ede9fe" style="--sw:#ede9fe" aria-label="Lila claro"></button>
                    <button type="button" data-c="#eff6ff" style="--sw:#eff6ff" aria-label="Celeste claro"></button>
                    <button type="button" data-c="#f0fdf4" style="--sw:#f0fdf4" aria-label="Menta"></button>
                    <button type="button" data-c="#fdf2f8" style="--sw:#fdf2f8" aria-label="Rosa claro"></button>
                  </div>
                </div>
              </div>
              <div class="qr-opt" id="opt-gradient">
                <label class="qr-check"><input type="checkbox" id="qrGradient" checked /> Degradado con <input type="color" id="qrGrad" value="#f5a524" aria-label="Segundo color del degradado" /></label>
                <div class="qr-seg qr-seg-2" id="qrGradType" role="group" aria-label="Tipo de degradado">
                  <button type="button" data-g="linear" class="on">Lineal</button>
                  <button type="button" data-g="radial">Radial</button>
                </div>
              </div>
              <div class="qr-opt" id="opt-dots">
                <div class="qr-opts qr-opts-6" id="qrDots">
                  <button type="button" data-v="square">■ Recto</button>
                  <button type="button" data-v="dots">● Puntos</button>
                  <button type="button" data-v="rounded" class="on">◧ Suave</button>
                  <button type="button" data-v="extra-rounded">⬢ Redondo</button>
                  <button type="button" data-v="classy">⬣ Elegante</button>
                  <button type="button" data-v="classy-rounded">⬔ Curvo</button>
                </div>
              </div>
              <div class="qr-opt" id="opt-corners">
                <div class="qr-field"><label>Esquinas</label>
                  <div class="qr-opts cols3" id="qrCorners">
                    <button type="button" data-v="square">Rectas</button>
                    <button type="button" data-v="dot">Punto</button>
                    <button type="button" data-v="extra-rounded" class="on">Redondas</button>
                  </div>
                </div>
                <div class="qr-field"><label>Centro esquinas</label>
                  <div class="qr-opts cols3" id="qrCornerDots">
                    <button type="button" data-v="dot" class="on">Punto</button>
                    <button type="button" data-v="square">Cuadro</button>
                  </div>
                </div>
              </div>
              <div class="qr-opt" id="opt-logo">
                <div class="qr-logo-row">
                  <label for="qrLogo"><i class="fa-solid fa-image"></i> Subir logo<input type="file" id="qrLogo" accept="image/*" hidden /></label>
                  <button type="button" id="qrNoLogo">Quitar</button>
                </div>
                <p class="qr-tip"><i class="fa-solid fa-circle-info"></i> Con logo usa corrección Q o H en el paso 1.</p>
              </div>
              <div class="qr-opt" id="opt-frame">
                <div class="qr-field"><label>Marco del preview</label>
                  <div class="qr-opts cols3" id="qrFrame">
                    <button type="button" data-v="card" class="on">Tarjeta</button>
                    <button type="button" data-v="plain">Sin marco</button>
                    <button type="button" data-v="dark">Oscuro</button>
                  </div>
                </div>
                <div class="qr-field"><label for="qrMargin">Margen de seguridad <b id="qrMarginVal">12</b></label>
                  <div class="qr-range"><input type="range" id="qrMargin" min="0" max="40" value="12" /></div>
                </div>
              </div>
            </div>

            <div class="qr-modal" id="qrModal" hidden>
              <div class="qr-modal-bg" id="qrModalBg"></div>
              <div class="qr-modal-box" role="dialog" aria-modal="true" aria-labelledby="qrModalTitle">
                <div class="qr-modal-head"><b id="qrModalTitle">Editar</b><button id="qrModalX" type="button" aria-label="Cerrar">✕</button></div>
                <div class="qr-modal-body" id="qrModalBody"></div>
                <div class="qr-modal-foot"><button class="btn btn-primary" id="qrModalDone" type="button">Listo</button></div>
              </div>
            </div>

            <div class="qr-panel" data-panel="2" role="tabpanel" aria-label="Descargar">
              <input type="hidden" id="qrFormat" value="png" />
              <div class="qr-field"><label>Tamaño de descarga <b id="qrSizeVal">1024px</b></label>
                <div class="qr-range"><input type="range" id="qrSize" min="512" max="2048" step="256" value="1024" /></div>
              </div>
              <div class="qr-seg" id="qrFmtSeg">
                <button type="button" data-fmt="png" class="on">PNG</button>
                <button type="button" data-fmt="svg">SVG</button>
                <button type="button" data-fmt="jpeg">JPG</button>
              </div>
              <div class="qr-field"><label for="qrFileName">Nombre del archivo</label><input type="text" id="qrFileName" value="qr-kat" placeholder="Ej: mi-negocio-menu" /></div>
              <button class="btn btn-primary grad-anim qr-dl-big" id="qrDownload" type="button"><i class="fa-solid fa-download"></i> Descargar QR en alta calidad</button>
              <div class="qr-dl-grid">
                <button type="button" id="qrCopyImg">Copiar imagen</button>
                <button type="button" id="qrCopyText">Copiar texto</button>
              </div>
              <div class="qr-cardbox">
                <h3><i class="fa-solid fa-id-card"></i> Tarjeta para compartir</h3>
                <p>1080×1350 con tu título, redes y estilo del paso 1. Lista para Instagram y WhatsApp.</p>
                <button class="btn btn-glass qr-dl-big" id="qrCardDownload" type="button"><i class="fa-solid fa-image"></i> Descargar tarjeta PNG</button>
                <button class="btn btn-ghost" id="qrCardSVG" type="button"><i class="fa-solid fa-vector-square"></i> Descargar tarjeta SVG</button>
              </div>
              <p class="qr-tip"><i class="fa-solid fa-circle-info"></i> Tip: usa fondo claro y puntos oscuros para que cualquier cámara lo lea al instante.</p>
            </div>
          </div>
        </div>

        <div class="qr-foot">
          <button class="btn btn-ghost" id="qrPrev" type="button">‹ Atrás</button>
          <div class="qr-progress"><small>Paso <b id="stepNow">1</b> de 3</small><i><b id="qrBar"></b></i></div>
          <button class="btn btn-primary" id="qrNext" type="button">Siguiente ›</button>
        </div>
      </section>
    </div>
  </div>
  <Fragment slot="after-footer">
    <script is:inline>
      // Progresivo: revela el generador aunque el JS principal aún no cargue.
      const reveal = () => {
        const app = document.getElementById("qrApp");
        if (app) { app.hidden = false; app.classList.add("on"); }
      };
      document.getElementById("qrStart")?.addEventListener("click", reveal, { once: true });
      document.getElementById("qrSample")?.addEventListener("click", reveal, { once: true });
    </script>
  </Fragment>
</BaseLayout>
