---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Cotizador Profesional | CodeKat"
  description="Cotizador profesional y general. Crea cotizaciones para cualquier negocio: emisor, cliente, ítems, creador de logo, diseño y colores. Descarga en PDF, Excel o TXT."
  themeColor="#08080D"
  fontHref="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap"
  footerAccent="amber"
  bgVariant="aurora"
  css={["/assets/css/pages/cotizador.css"]}
  scripts={[
    "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js",
    "https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js",
    "/assets/js/functions/cotizador-app.js",
    "/assets/js/functions/reveal.js",
  ]}
>
  <Fragment slot="pre-main">
    <div class="app-intro"><h1>Cotizador <em class="grad-text">profesional</em></h1></div>

    <div class="wizard-nav-wrap">
      <div class="container"><div class="wizard-nav" id="wizardNav" role="tablist" aria-label="Pasos del cotizador"></div></div>
    </div>
  </Fragment>

  <div class="container">

    <section class="wpanel active" data-panel="0">
      <div class="cot-card">
        <div class="cot-card-head">
          <span class="cot-card-ico"><i class="fa-solid fa-store"></i></span>
          <div><h2>Tu negocio (quien cotiza)</h2><p>Datos de quien envía la cotización</p></div>
        </div>
        <div class="field-grid">
          <div class="field"><label>Nombre / Empresa *</label><input type="text" id="senderName" placeholder="Ej: Comercial Pérez" /></div>
          <div class="field"><label>Identificación (RUT, NIT, RFC…)</label><input type="text" id="senderTax" placeholder="Ej: 76.123.456-7" /></div>
          <div class="field"><label>Correo</label><input type="email" id="senderEmail" placeholder="ventas@tunegocio.com" /></div>
          <div class="field"><label>Teléfono</label><input type="tel" id="senderPhone" placeholder="+56 9 ..." /></div>
          <div class="field full"><label>Sitio web / Dirección</label><input type="text" id="senderWeb" placeholder="www.tunegocio.com · Av. Siempre Viva 742" /></div>
          <div class="field full">
            <label>Logo</label>
            <div class="logo-drop">
              <span class="logo-thumb" id="logoThumb"><i class="fa-regular fa-image"></i></span>
              <input type="file" id="logoInput" accept="image/*" />
              <button class="btn btn-ghost btn-sm" id="openLogoMaker" type="button"><i class="fa-solid fa-wand-magic-sparkles"></i> Crear logo</button>
              <button class="btn btn-ghost btn-sm" id="removeLogo" type="button"><i class="fa-solid fa-xmark"></i> Quitar</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="wpanel" data-panel="1">
      <div class="cot-card">
        <div class="cot-card-head">
          <span class="cot-card-ico"><i class="fa-solid fa-user"></i></span>
          <div><h2>Cliente (quien recibe)</h2><p>Datos de tu cliente o prospecto</p></div>
        </div>
        <div class="field-grid">
          <div class="field"><label>Nombre *</label><input type="text" id="clientName" placeholder="Ej: María González" /></div>
          <div class="field"><label>Empresa</label><input type="text" id="clientCompany" placeholder="Ej: Café Aurora" /></div>
          <div class="field"><label>Correo</label><input type="email" id="clientEmail" placeholder="cliente@correo.com" /></div>
          <div class="field"><label>Teléfono</label><input type="tel" id="clientPhone" placeholder="+56 9 ..." /></div>
        </div>
      </div>
    </section>

    <section class="wpanel" data-panel="2">
      <div class="cot-card">
        <div class="cot-card-head">
          <span class="cot-card-ico"><i class="fa-solid fa-list-check"></i></span>
          <div><h2>Ítems de la cotización</h2><p>Arrastra para reordenar · toca ✎ para editar</p></div>
        </div>
        <div class="items-list" id="itemsList"></div>
        <button class="btn btn-primary" id="openItemModal" type="button"><i class="fa-solid fa-plus"></i> Agregar ítem</button>
        <div class="items-total-bar"><span>Total actual</span><span id="itemsTotalChip">—</span></div>
      </div>
    </section>

    <section class="wpanel" data-panel="3">
      <div class="cot-card">
        <div class="cot-card-head">
          <span class="cot-card-ico"><i class="fa-solid fa-file-invoice"></i></span>
          <div><h2>Detalles de la cotización</h2><p>Título, número, fecha, moneda e impuestos</p></div>
        </div>
        <div class="field-grid">
          <div class="field"><label>Título</label><input type="text" id="quoteTitle" value="Cotización" /></div>
          <div class="field"><label>N° de cotización</label><input type="text" id="quoteNumber" /></div>
          <div class="field"><label>Fecha</label><input type="date" id="quoteDate" /></div>
          <div class="field"><label>Válida por (días)</label><input type="number" id="validDays" value="15" min="0" /></div>
          <div class="field"><label>Moneda</label>
            <select id="currency">
              <option value="$">$ — Peso</option>
              <option value="US$">US$ — Dólar</option>
              <option value="€">€ — Euro</option>
              <option value="MX$">MX$ — Peso mexicano</option>
              <option value="S/">S/ — Sol</option>
              <option value="Bs">Bs — Bolívar</option>
            </select>
          </div>
          <div class="field"><label>Descuento %</label><input type="number" id="discountInput" value="0" min="0" max="100" /></div>
          <div class="field"><label>Impuesto % (IVA)</label><input type="number" id="taxInput" value="0" min="0" max="100" /></div>
          <div class="field full"><label>Notas / condiciones</label><textarea id="quoteNotes" placeholder="Ej: Precios con IVA incluido. Pago 50% al iniciar..."></textarea></div>
        </div>
      </div>
    </section>

    <section class="wpanel" data-panel="4">
      <div class="cot-card">
        <div class="cot-card-head">
          <span class="cot-card-ico"><i class="fa-solid fa-paintbrush"></i></span>
          <div><h2>Diseño de la cotización</h2><p>Desliza para elegir diseño y colores</p></div>
        </div>
        <div class="design-grid" id="designGrid"></div>
        <div class="palette-row" id="paletteRow"></div>
        <div class="color-row">
          <div class="color-field"><label>Primario</label><input type="color" id="colorPrimary" value="#8B5CF6" /></div>
          <div class="color-field"><label>Secundario</label><input type="color" id="colorSecondary" value="#C4B5FD" /></div>
          <div class="color-field"><label>Acento</label><input type="color" id="colorAccent" value="#7C3AED" /></div>
        </div>
      </div>
    </section>

    <section class="wpanel" data-panel="5">
      <div class="cot-card">
        <div class="cot-card-head">
          <span class="cot-card-ico"><i class="fa-solid fa-eye"></i></span>
          <div><h2>Vista previa</h2><p>Así se verá tu cotización</p></div>
        </div>
        <div class="quote-doc" id="quoteDoc"></div>
      </div>
    </section>

    <section class="wpanel" data-panel="6">
      <div class="cot-card">
        <div class="cot-card-head">
          <span class="cot-card-ico"><i class="fa-solid fa-download"></i></span>
          <div><h2>Resumen y descarga</h2><p>Revisa el total, nombra el archivo y exporta</p></div>
        </div>
        <div class="totals-card">
          <div class="totals-row"><span>Subtotal</span><span id="tSub">—</span></div>
          <div class="totals-row"><span>Descuento (<span id="tDiscLabel">0</span>%)</span><span id="tDisc">—</span></div>
          <div class="totals-row"><span>Impuesto (<span id="tTaxLabel">0</span>%)</span><span id="tTax">—</span></div>
          <div class="totals-row total"><span>Total</span><span id="tTotal">—</span></div>
        </div>
        <div class="field full" style="margin-bottom:.85rem;">
          <label>Nombre del archivo a descargar</label>
          <input type="text" id="fileName" placeholder="Ej: Cotización Cliente X" value="Cotización" />
        </div>
        <div class="actions-grid">
          <button class="btn btn-primary" id="btnPDF"><i class="fa-solid fa-file-pdf"></i> Descargar PDF</button>
          <button class="btn btn-ghost" id="btnExcel"><i class="fa-solid fa-file-excel"></i> Excel (CSV)</button>
          <button class="btn btn-ghost" id="btnTXT"><i class="fa-solid fa-file-lines"></i> TXT</button>
          <button class="btn btn-ghost" id="btnPrint"><i class="fa-solid fa-print"></i> Imprimir</button>
          <button class="btn btn-primary" id="btnEmail" style="grid-column:1/-1;"><i class="fa-regular fa-envelope"></i> Enviar por correo</button>
        </div>
        <p style="font-size:.74rem;color:var(--text-dim);margin-top:.85rem;"><i class="fa-solid fa-circle-info" style="color:var(--amb);"></i> El envío por correo abre tu aplicación de correo (gratis). Adjunta el PDF si lo necesitas.</p>
      </div>
    </section>

  </div>

  <div class="wizard-footer-wrap" id="wizardFooterWrap">
    <div class="wizard-footer">
      <button class="btn btn-ghost" id="prevBtn"><i class="fa-solid fa-arrow-left"></i> Atrás</button>
      <div class="wf-center">
        <span class="wf-counter">Paso <b id="stepNow">1</b> de <span id="stepTotal">7</span></span>
        <div class="wf-progress"><span id="progressBar"></span></div>
      </div>
      <button class="btn btn-primary" id="nextBtn">Siguiente <i class="fa-solid fa-arrow-right"></i></button>
    </div>
  </div>

  <Fragment slot="after-footer">
    <div class="fm-backdrop" id="lmBackdrop" aria-hidden="true">
      <div class="fm-box" role="dialog" aria-modal="true" aria-label="Creador de logo">
        <div class="fm-head">
          <h3><i class="fa-solid fa-wand-magic-sparkles"></i> Creador de logo</h3>
          <button class="fm-close" id="lmClose" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="fm-body">
          <div class="lm-grid">
            <div class="lm-controls">
              <div class="field"><label>Iniciales</label><input id="lmInitials" maxlength="3" placeholder="CK" /></div>
              <div class="field"><label>Forma</label>
                <select id="lmShape">
                  <option value="rounded">Cuadrado redondeado</option>
                  <option value="circle">Círculo</option>
                </select>
              </div>
              <div class="lm-row2">
                <div class="field"><label>Color fondo</label><input type="color" id="lmBg" value="#8B5CF6" /></div>
                <div class="field"><label>Color texto</label><input type="color" id="lmText" value="#FFFFFF" /></div>
              </div>
              <div class="field"><label>Estilo</label>
                <select id="lmStyle">
                  <option value="solid">Sólido</option>
                  <option value="gradient">Degradado</option>
                </select>
              </div>
            </div>
            <div class="lm-preview-col">
              <canvas id="lmCanvas" width="240" height="240"></canvas>
              <button class="btn btn-primary" id="lmUse" type="button"><i class="fa-solid fa-check"></i> Usar este logo</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="fm-backdrop" id="itemBackdrop" aria-hidden="true">
      <div class="fm-box" role="dialog" aria-modal="true" aria-label="Ítem">
        <div class="fm-head">
          <h3 id="itemModalTitle"><i class="fa-solid fa-list-check"></i> Agregar ítem</h3>
          <button class="fm-close" id="itemClose" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="fm-body">
          <div class="field" style="margin-bottom:.7rem;"><label>Concepto *</label><input id="itemModalName" placeholder="Ej: Producto o servicio" /></div>
          <div class="field" style="margin-bottom:.7rem;"><label>Descripción</label><input id="itemModalDesc" placeholder="Detalle breve (opcional)" /></div>
          <div class="im-row2">
            <div class="field"><label>Cantidad</label><input id="itemModalQty" type="number" value="1" min="0" step="any" /></div>
            <div class="field"><label>Precio unitario</label><input id="itemModalPrice" type="number" value="0" min="0" step="any" /></div>
          </div>
        </div>
        <div class="fm-foot">
          <button class="btn btn-ghost" id="itemCancel" type="button">Cancelar</button>
          <button class="btn btn-primary" id="itemSave" type="button"><i class="fa-solid fa-check"></i> Guardar</button>
        </div>
      </div>
    </div>

    <div class="toast" id="toast"><i class="fa-solid fa-circle-check"></i><span id="toastMsg"></span></div>
  </Fragment>
</BaseLayout>
