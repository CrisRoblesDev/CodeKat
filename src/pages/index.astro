---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://codekat.store/#website",
  url: "https://codekat.store/",
  name: "CodeKat",
  publisher: { "@id": "https://codekat.store/#organization" },
  inLanguage: "es-CL",
};
---
<BaseLayout
  title="CodeKat | Desarrollo Web y Landing Pages en Chile"
  description="Creamos landing pages, páginas informativas y soluciones web enfocadas en captar clientes, mejorar tu presencia online y hacer crecer tu negocio."
  themeColor="#8B5CF6"
  canonical="https://codekat.store/"
  fontHref="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
  isHome
  footerAccent="purple"
  withLoader
  withScrollProgress
  bgVariant="aurora4"
  css={[
    "/assets/css/colors.css?v=11",
    "/assets/css/design.css?v=11",
    "/assets/css/components.css?v=11",
    "/assets/css/pages/index-hero.css?v=11",
    "/assets/css/pages/index-sections.css?v=11",
    "/assets/css/footer.css?v=11",
    "/assets/css/modal.css?v=11",
    "/assets/css/system.css?v=11",
    "/assets/css/pages/index-stepper.css?v=11",
    "/assets/css/pages/index-quote.css?v=11",
  ]}
  scripts={[
    "/assets/js/functions/theme.js?v=11",
    "/assets/js/functions/menu.js?v=11",
    "/assets/js/functions/widgets.js?v=11",
    "/assets/js/functions/hero-shader.js?v=11",
    "/assets/js/animations/hero-parallax.js?v=11",
    "/assets/js/animations/stepper.js?v=11",
    "/assets/js/animations/loader.js?v=11",
    "/assets/js/animations/marquee.js?v=11",
    "/assets/js/functions/faq.js?v=11",
    "/assets/js/functions/quote.js?v=11",
    "/assets/js/animations/magnetic.js?v=11",
  ]}
>
  <Fragment slot="head">
    <meta name="keywords" content="desarrollo web Chile, landing pages, páginas web, diseño web, CodeKat, Santiago, Chile" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://codekat.store/" />
    <meta property="og:site_name" content="CodeKat" />
    <meta property="og:title" content="CodeKat | Desarrollo Web y Landing Pages en Chile" />
    <meta property="og:description" content="Diseñamos páginas web modernas, rápidas y enfocadas en convertir visitantes en clientes." />
    <meta property="og:image" content="https://codekat.store/favicon-512x512.png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Logo CodeKat" />
    <meta property="og:locale" content="es_CL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CodeKat | Desarrollo Web y Landing Pages en Chile" />
    <meta name="twitter:description" content="Diseñamos páginas web modernas, rápidas y enfocadas en convertir visitantes en clientes." />
    <meta name="twitter:image" content="https://codekat.store/favicon-512x512.png" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  </Fragment>

  <section class="hero" id="inicio" aria-label="Inicio">
    <canvas id="heroShader" aria-hidden="true"></canvas>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-conic" aria-hidden="true"></div>
    <div class="hx-behind" aria-hidden="true">
      <div class="hx-glow" data-hx="0.12"></div>
      <div class="hx-ring" data-hx="0.60"></div>
    </div>
    <div class="container">
      <div class="hx-first">
        <div class="hx-ghost" id="hxGhost" aria-hidden="true"><span class="hx-code" id="hxCode">CODE</span><span class="hx-kat" id="hxKat">KAT</span></div>
        <div class="hero-intro reveal" id="heroIntro">
          <div class="hero-badge-wrap animate-fade-in-down">
            <span class="hero-badge"><i class="fa-solid fa-wand-magic-sparkles"></i> Desarrollo web · Chile</span>
          </div>
          <h1 class="hero-title">
            <span class="hl-line1 animate-fade-in-up animation-delay-200">Tu próxima página web</span>
            <span class="hl-line2 animate-fade-in-up animation-delay-400">comienza aquí</span>
          </h1>
          <p class="hero-subtitle animate-fade-in-up animation-delay-600">Diseñamos páginas web modernas, rápidas y enfocadas en convertir visitantes en clientes. Presencia profesional, claridad y resultados para tu negocio.</p>
          <div class="hero-ctas animate-fade-in-up animation-delay-800">
            <a href="https://wa.me/56933465843" class="btn btn-primary grad-anim" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Hablar por WhatsApp</a>
            <a href="#faq" class="btn btn-glass">Resuelve tus dudas <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
      </div>

      <div class="hero-steps reveal delay-1">
        <h2 class="hero-steps-title">Cómo trabajamos</h2>
        <div class="steps-flow st-layout" id="stStepper">
          <div class="st-car">
            <button class="st-arrow" id="stPrev" aria-label="Paso anterior">‹</button>
            <div class="st-pills" role="tablist" aria-label="Pasos: cómo trabajamos">
              <button class="st-pill on" role="tab" aria-selected="true" data-go="0">
                <span class="st-num">1</span>
                <span class="st-txt"><b>Contacto</b><small>Escríbeme por WhatsApp</small></span>
                <span class="st-track" aria-hidden="true"><span class="st-fill"></span></span>
              </button>
              <button class="st-pill" role="tab" aria-selected="false" data-go="1">
                <span class="st-num">2</span>
                <span class="st-txt"><b>Prototipo</b><small>Recibe el link en 48–72h</small></span>
                <span class="st-track" aria-hidden="true"><span class="st-fill"></span></span>
              </button>
              <button class="st-pill" role="tab" aria-selected="false" data-go="2">
                <span class="st-num">3</span>
                <span class="st-txt"><b>Despliegue</b><small>Publicamos y apareces en Google</small></span>
                <span class="st-track" aria-hidden="true"><span class="st-fill"></span></span>
              </button>
            </div>
            <button class="st-arrow" id="stNext" aria-label="Paso siguiente">›</button>
          </div>
          <div class="st-count" aria-hidden="true"><b id="stCur">01</b> / 03</div>
          <div class="st-stage" id="stStage">
            <article class="st-card active" data-step="0" role="tabpanel" aria-label="Paso 1: Contacto">
              <span class="st-tag">Paso 1 · Contacto</span>
              <h3 class="st-h3">Escríbeme por WhatsApp</h3>
              <div class="wa-mock" aria-hidden="true">
                <div class="wa-head"><span class="wa-av"><img src="/assets/images/logos/Logo.png" alt="CodeKat" /></span><span class="wa-who">CodeKat<small><i class="wa-dot"></i>en línea</small></span></div>
                <div class="wa-day">HOY</div>
                <div class="wa-b wa-in">Hola, quiero una web 🙂 <small>10:24</small></div>
                <div class="wa-swap"><div class="wa-typing"><span></span><span></span><span></span></div>
                <div class="wa-b wa-out">¡Hola! ¿De qué es tu negocio? <span class="ticks">✓✓</span> <small>10:25</small></div></div>
              </div>
              <p class="st-desc">Me escribes por WhatsApp y me cuentas de tu negocio. Respondo el mismo día.</p>
              <span class="st-meta">⏱ Respuesta el mismo día</span>
            </article>
            <article class="st-card" data-step="1" role="tabpanel" aria-label="Paso 2: Prototipo">
              <span class="st-tag">Paso 2 · Prototipo</span>
              <h3 class="st-h3">Revisa tu diseño en un link</h3>
              <div class="pt-mock" aria-hidden="true">
                <div class="pt-head"><span class="wa-av"><img src="/assets/images/logos/Logo.png" alt="CodeKat" /></span><b>CodeKat</b><span class="pt-ver">v1.2</span></div>
                <div class="wa-b wa-in pt-ask">¿Cómo va mi página? 👀 <small>14:02</small></div>
                <div class="pt-conv"><div class="wa-typing pt-ty"><span></span><span></span><span></span></div>
                <div class="wa-b wa-out pt-ans">¡Lista! Mírala aquí 👇 <span class="ticks">✓✓</span> <small>14:03</small></div></div>
                <div class="pt-swap">
                  <div class="pt-link"><span class="pt-lock">🔒</span><span class="pt-url">tu-prototipo.codekat.store</span><span class="pt-copy">Entrar →</span><div class="pt-cursor" aria-hidden="true">👆</div></div>
                  <div class="pt-site"><span class="pt-site-url">🔒 tu-prototipo.codekat.store</span><span class="pt-page"><span class="pt-pnav"><i></i><i></i><i></i><em>☕ Café Aurora</em><u>Reservar</u></span><b>El mejor café de tu barrio</b><small>★★★★★ 4.8 · Hecho con amor en Santiago</small><span class="pt-phero">☕</span><span class="pt-prow"><i>Ver menú →</i><i class="o">Pedir</i></span><span class="pt-pfeats"><em>⚡ Carga rápida</em><em>📱 Responsive</em><em>✓ SEO listo</em></span></span></div>
                </div>
              </div>
              <p class="st-desc">En 48–72 horas recibes un link con el diseño real. Apruebas o pides ajustes.</p>
              <span class="st-meta">🔗 Link privado por 7 días</span>
            </article>
            <article class="st-card" data-step="2" role="tabpanel" aria-label="Paso 3: Despliegue">
              <span class="st-tag">Paso 3 · Despliegue</span>
              <h3 class="st-h3">Aparece en Google</h3>
              <div class="gg-mock" aria-hidden="true">
                <div class="gg-ready">¡Tu web está lista! 🎉</div>
                <div class="gg-bar"><span class="gg-g">G</span><span class="gg-q">café aurora</span></div>
                <div class="gg-tools">Todos · Imágenes · Maps · Noticias</div>
                <div class="gg-res gg-r1"><b>☕ Café Aurora</b><small>caféaurora.cl · ★★★★★ 4.8</small><div class="gg-cursor" aria-hidden="true">👆</div></div>
                <div class="gg-res gg-r2"><b>Mapa · Cómo llegar</b><small>a 5 min de ti</small></div>
                <div class="gg-res gg-r3"><b>💬 Opiniones de clientes</b><small>"El mejor café del barrio" · 420 reseñas</small></div>
                <div class="gg-site"><span class="gg-site-url">🔒 caféaurora.cl · En línea</span><span class="gg-site-hero">☕<b>Café Aurora</b><i>Ver menú →</i></span><span class="gg-site-info">★★★★★ 4.8 · 📍 Av. Italia 1234 · 🕐 Abierto</span><span class="gg-site-row"><em>📞 Llamar</em><em>🗺️ Cómo llegar</em><em>⭐ Opiniones</em></span></div>
              </div>
              <p class="st-desc">Publicamos tu web optimizada y apareces en Google, lista para recibir clientes.</p>
              <span class="st-meta">🚀 En línea en 24–48h</span>
            </article>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-divider" aria-hidden="true"><span></span><i></i><span></span></div>
    <div class="hero-scroll-hint" aria-hidden="true"><span>Desliza</span><i class="fa-solid fa-chevron-down"></i></div>
  </section>

  <section class="clients-section" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container">
      <div class="section-head reveal">
        <span class="section-accent" aria-hidden="true"></span>
        <h2 class="section-title" id="servicios-titulo">Empresas que han <em class="grad-text">confiado en nosotros</em>.</h2>
        <p class="section-subtitle">Nos enorgullece haber trabajado con estas empresas.</p>
      </div>
    </div>
    <div class="clients-marquee-wrap">
      <div class="clients-marquee" id="clientsMarquee">
        <div class="clients-track" id="clientsTrack">
          <a href="https://www.we-service.cl" target="_blank" rel="noopener" class="client-card" aria-label="We Service - we-service.cl"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/weservice.png" alt="We Service" loading="lazy"></span><span class="client-info"><span class="client-name">We Service</span><span class="client-domain"><i class="fa-solid fa-globe"></i> we-service.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.sisvial.cl" target="_blank" rel="noopener" class="client-card" aria-label="Sisvial - sisvial.cl"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/sisvial.png" alt="Sisvial" loading="lazy"></span><span class="client-info"><span class="client-name">Sisvial</span><span class="client-domain"><i class="fa-solid fa-globe"></i> sisvial.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.bonsaicare.cl" target="_blank" rel="noopener" class="client-card" aria-label="Bonsai Care - bonsaicare.cl"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/bonsaicare.png" alt="Bonsai Care" loading="lazy"></span><span class="client-info"><span class="client-name">Bonsai Care</span><span class="client-domain"><i class="fa-solid fa-globe"></i> bonsaicare.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.we-service.cl" target="_blank" rel="noopener" class="client-card" aria-hidden="true" tabindex="-1"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/weservice.png" alt="" loading="lazy"></span><span class="client-info"><span class="client-name">We Service</span><span class="client-domain"><i class="fa-solid fa-globe"></i> we-service.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.we-service.cl" target="_blank" rel="noopener" class="client-card" aria-hidden="true" tabindex="-1"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/sisvial.png" alt="" loading="lazy"></span><span class="client-info"><span class="client-name">Sisvial</span><span class="client-domain"><i class="fa-solid fa-globe"></i> sisvial.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.we-service.cl" target="_blank" rel="noopener" class="client-card" aria-hidden="true" tabindex="-1"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/bonsaicare.png" alt="" loading="lazy"></span><span class="client-info"><span class="client-name">Bonsai Care</span><span class="client-domain"><i class="fa-solid fa-globe"></i> bonsaicare.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.we-service.cl" target="_blank" rel="noopener" class="client-card" aria-hidden="true" tabindex="-1"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/weservice.png" alt="" loading="lazy"></span><span class="client-info"><span class="client-name">We Service</span><span class="client-domain"><i class="fa-solid fa-globe"></i> we-service.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.we-service.cl" target="_blank" rel="noopener" class="client-card" aria-hidden="true" tabindex="-1"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/sisvial.png" alt="" loading="lazy"></span><span class="client-info"><span class="client-name">Sisvial</span><span class="client-domain"><i class="fa-solid fa-globe"></i> sisvial.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
          <a href="https://www.we-service.cl" target="_blank" rel="noopener" class="client-card" aria-hidden="true" tabindex="-1"><span class="card-glow"></span><span class="shine"></span><span class="client-logo-wrap"><img src="/assets/images/clients/bonsaicare.png" alt="" loading="lazy"></span><span class="client-info"><span class="client-name">Bonsai Care</span><span class="client-domain"><i class="fa-solid fa-globe"></i> bonsaicare.cl</span></span><span class="client-cta"><i class="fa-solid fa-arrow-up-right-from-square"></i></span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-section" id="cotizacion" aria-labelledby="cotizacion-titulo">
    <div class="container">
      <div class="section-head reveal">
        <span class="section-accent" aria-hidden="true"></span>
        <h2 class="section-title" id="cotizacion-titulo">Cotiza tu web en <em class="grad-text">3 preguntas</em>.</h2>
        <p class="section-subtitle">Responde y descubre al instante qué necesitas y cuánto cuesta. Sin compromiso.</p>
      </div>
      <div class="quote-teaser reveal">
        <div class="quote-teaser-steps" aria-hidden="true">
          <span><i class="fa-solid fa-globe"></i> Dominio</span>
          <span><i class="fa-solid fa-pen-to-square"></i> Autogestión</span>
          <span><i class="fa-solid fa-envelope"></i> Correo</span>
        </div>
        <p class="quote-teaser-txt">3 preguntas, 1 minuto y tu presupuesto listo para enviar por WhatsApp.</p>
        <button class="btn btn-primary grad-anim" id="quoteOpen" type="button"><i class="fa-solid fa-calculator"></i> Comenzar cotización</button>
      </div>
    </div>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-titulo">
    <div class="container">
      <div class="section-head reveal">
        <span class="section-accent" aria-hidden="true"></span>
        <span class="faq-accent" aria-hidden="true"></span>
        <h2 class="section-title" id="faq-titulo">FAQ — <em class="grad-text">Resuelve tus consultas</em>.</h2>
        <p class="section-subtitle">Respuestas directas a las preguntas más comunes sobre nuestros servicios.</p>
      </div>
      <div class="faq-list" id="faqList">
        <div class="faq-item reveal">
          <div class="faq-q" data-faq="0" role="button" aria-expanded="false" tabindex="0">
            <span class="faq-q-num">01</span>
            <span class="faq-q-text">¿Cuánto dura el servicio?</span>
            <span class="faq-chev"><i class="fa-solid fa-plus"></i></span>
          </div>
          <div class="faq-a" id="faq-a0">
            <div class="faq-a-inner">El servicio funciona con un <strong>límite de más de 500,000 consultas mensuales</strong> (tope del plan gratuito de Cloudflare Pages para funciones). Los activos estáticos tienen ancho de banda ilimitado. Estadísticas oficiales: <strong>500,000 consultas/mes</strong> · <strong>Ilimitado</strong> en activos estáticos · <strong>$0</strong> hosting + funciones gratis. Si necesitas renovar la página, solo debes <strong>renovar el dominio</strong>. Sin costo extra de mantenimiento mientras el dominio esté activo.</div>
          </div>
        </div>
        <div class="faq-item reveal delay-1">
          <div class="faq-q" data-faq="1" role="button" aria-expanded="false" tabindex="0">
            <span class="faq-q-num">02</span>
            <span class="faq-q-text">¿Qué es el SEO?</span>
            <span class="faq-chev"><i class="fa-solid fa-plus"></i></span>
          </div>
          <div class="faq-a" id="faq-a1">
            <div class="faq-a-inner">Nuestra configuración de SEO incluye la <strong>indexación básica</strong> para que puedas posicionarte por el nombre de tu empresa y te encuentren de forma sencilla. La indexación está a cargo de <strong>Google Search Console</strong>, lo que no asegura posicionarte entre los primeros al buscar por servicios genéricos. Si requieres otra forma de promoción, se debe incluir <strong>por separado</strong>, ya que los precios son variables, dependen del tiempo y <strong>no garantizan el resultado esperado</strong>.</div>
          </div>
        </div>
        <div class="faq-item reveal delay-2">
          <div class="faq-q" data-faq="2" role="button" aria-expanded="false" tabindex="0">
            <span class="faq-q-num">03</span>
            <span class="faq-q-text">¿Puedo obtener mi código de desarrollo?</span>
            <span class="faq-chev"><i class="fa-solid fa-plus"></i></span>
          </div>
          <div class="faq-a" id="faq-a2">
            <div class="faq-a-inner">¡Sí! Trabajamos con nuestro <strong>repositorio público de GitHub</strong>. Puedes solicitar el código o pedirnos acceso al repositorio. Así podrás editarlo mediante <strong>Git</strong> o directamente desde <strong>GitHub</strong>. Solo necesitas poseer una cuenta de GitHub.</div>
          </div>
        </div>
        <div class="faq-item reveal delay-1">
          <div class="faq-q" data-faq="3" role="button" aria-expanded="false" tabindex="0">
            <span class="faq-q-num">04</span>
            <span class="faq-q-text">¿Qué debo tener en cuenta?</span>
            <span class="faq-chev"><i class="fa-solid fa-plus"></i></span>
          </div>
          <div class="faq-a" id="faq-a3">
            <div class="faq-a-inner">Debes tener en cuenta un <strong>nombre de dominio</strong> y, en caso de querer correo, un <strong>nombre de correo</strong>. Por la dificultad de encontrar nombres de dominio disponibles, es bueno tener un nombre <strong>ingenioso, simple y poco utilizado</strong> que facilite tanto el dominio como el correo.</div>
          </div>
        </div>
        <div class="faq-item reveal delay-2">
          <div class="faq-q" data-faq="4" role="button" aria-expanded="false" tabindex="0">
            <span class="faq-q-num">05</span>
            <span class="faq-q-text">¿Hosting y colaboración?</span>
            <span class="faq-chev"><i class="fa-solid fa-plus"></i></span>
          </div>
          <div class="faq-a" id="faq-a4">
            <div class="faq-a-inner">Debido a que ocupamos <strong>Cloudflare</strong> para el despliegue del hosting, y requiere que otro desarrollador intervenga, solo se puede facilitar <strong>acceso a GitHub</strong>. La mayoría de los trabajos son estáticos y sin cPanel, lo que nos permite <strong>desplegar tu página más rápido</strong> y <strong>realizar cambios de manera más sencilla</strong>.</div>
          </div>
        </div>
      </div>
      <div class="faq-cta reveal">
        <p class="section-subtitle">¿Aún tienes dudas? Escribenos por WhatsApp y te respondemos al instante.</p>
        <a href="https://wa.me/56933465843" class="btn btn-primary grad-anim" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Consultar por WhatsApp</a>
      </div>
    </div>
  </section>

  <Fragment slot="after-footer">
